<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".Application"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:description="@string/text_description_xposed"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <receiver
            android:name=".ControllerReceiver"
            android:exported="true" />

        <meta-data
            android:name="me_description"
            android:value="@string/text_description" />

        <!--
            Modern (libxposed API 102) module: the entry point and metadata live in
            src/main/resources/META-INF/xposed (java_init.list / module.prop), the legacy
            xposedmodule / xposedminversion / xposedsharedprefs meta-data is no longer used.
            Module name and description come from android:label / android:description.
        -->
    </application>
</manifest>